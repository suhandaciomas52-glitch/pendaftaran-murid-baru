<%- include('partials/header', { user: null, activePage: '' }) %>
<div class="container auth-wrap">
  <div class="auth-logo">
    <h1>Buat Akun</h1>
    <p>Daftar sebagai calon siswa</p>
  </div>
  <%- include('partials/alerts', { message, error }) %>
  <div class="card">
    <form method="POST" action="/register">
      <div class="form-group">
        <label>Nama Lengkap</label>
        <input class="form-control" name="name" value="<%= form && form.name ? form.name : '' %>" required>
      </div>
      <div class="form-group">
        <label>Email</label>
        <input class="form-control" type="email" name="email" value="<%= form && form.email ? form.email : '' %>" required>
      </div>
      <div class="form-group">
        <label>Password (min. 6 karakter)</label>
        <input class="form-control" type="password" name="password" minlength="6" required>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Daftar</button>
    </form>
  </div>
  <p class="text-center muted mt">Sudah punya akun? <a href="/login">Masuk</a></p>
</div>
<%- include('partials/footer') %>