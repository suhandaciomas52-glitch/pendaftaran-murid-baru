<%- include('partials/header', { user: null, activePage: '' }) %>
<div class="container auth-wrap">
  <div class="auth-logo">
    <h1>EduEnroll</h1>
    <p>Masuk ke akun PPDB Anda</p>
  </div>
  <%- include('partials/alerts', { message, error }) %>
  <div class="card">
    <form method="POST" action="/login">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="form-group">
        <label>Email</label>
        <input class="form-control" type="email" name="email" value="<%= form && form.email ? form.email : '' %>" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input class="form-control" type="password" name="password" required>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Masuk</button>
    </form>
  </div>
  <p class="text-center muted mt">Belum punya akun? <a href="/register">Daftar di sini</a></p>
</div>
<%- include('partials/footer') %>